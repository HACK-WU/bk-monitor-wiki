{
  "mcpServers": {
    "gitnexus": {
      "command": "gitnexus",
      "args": ["mcp"]
    },
    "memory": {
      "command": "mem",
      "args": ["serve"],
      "env": {
        "SILICONFLOW_API_KEY": "{{SILICONFLOW_API_KEY}}"
      }
    },
    "ki": {
      "command": "ki",
      "args": ["mcp"],
      "env": {
        "SILICONFLOW_API_KEY": "{{SILICONFLOW_API_KEY}}"
      }
    },
    "iWiki官方MCP": {
      "url": "https://xxxxx/app_iwiki_mcp/mcp3",
      "headers": {
        "x-readonly": "true",
        "Authorization": "Bearer tai_pat_xxxxxx"
      }
    }
  }
}