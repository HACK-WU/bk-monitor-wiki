{
  "mcpServers": {
    "gitnexus": {
      "command": "gitnexus",
      "args": ["mcp"]
    },
    "memory": {
      "command": "mem",
      "args": ["serve"],
      "env": {
        "SILICONFLOW_API_KEY": "{{SILICONFLOW_API_KEY}}"
      }
    },
    "ki": {
      "command": "ki",
      "args": ["mcp"],
      "env": {
        "SILICONFLOW_API_KEY": "{{SILICONFLOW_API_KEY}}"
      }
    }
  }
}