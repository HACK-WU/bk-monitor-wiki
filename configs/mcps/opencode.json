{
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": ["gitnexus", "mcp"]
    },
    "memory": {
      "type": "local",
      "command": ["mem", "serve"],
      "environment": {
        "SILICONFLOW_API_KEY": "{{SILICONFLOW_API_KEY}}"
      }
    },
    "ki": {
      "type": "local",
      "command": ["ki", "mcp"],
      "environment": {
        "SILICONFLOW_API_KEY": "{{SILICONFLOW_API_KEY}}"
      }
    },
    "iWiki官方MCP": {
      "type": "remote",
      "url": "https://xxxxx/app_iwiki_mcp/mcp3",
      "headers": {
        "x-readonly": "true",
        "Authorization": "Bearer tai_pat_xxxxxx"
      }
    }
  }
}
