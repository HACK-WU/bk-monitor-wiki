  "cards": [
    { "dot": "cyan", "title": "三个时间字段", "items": ["begin_time 决定文档写入哪个索引，也决定查询窗口下界", "create_time 只在初始化赋值，决定 reindex 搬运资格", "update_time 每次变更刷新，是双副本去重的排序依据"] },
    { "dot": "emerald", "title": "搬运的真实条件", "items": ["必须是 status=ABNORMAL，已恢复告警不再搬运", "create_time 不能早于新索引日期，长期存活的旧告警不搬运", "reindex 只在真正创建新索引时触发，日常约 59/60 次不执行"] },
    { "dot": "amber", "title": "查询收敛铁律", "items": ["精确 ID 查询的索引窗口上界必须恒为 now", "各种落点都落在 [begin_time, now] 区间内，这是唯一安全窗口", "无法推断时间锚点的查询走 all_indices=True"] },
    { "dot": "rose", "title": "一致性缺口", "items": ["reindex 与 delete_by_query 之间存在双副本过渡期", "mget 按 -update_time 排序去重，get 未做同样防护", "delete_by_query 失败会长期留下双副本，无自动补偿"] }
  ]
